{
  "name": "km-review",
  "displayName": "km · chancela",
  "description": "O que mudou desde a sua chancela, e quanto falta aprovar.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "km.abrirPainel",
        "title": "km: abrir o painel da chancela"
      },
      {
        "command": "km.review",
        "title": "km: diff contra a chancela, aqui no editor"
      },
      {
        "command": "km.veredicto",
        "title": "km: aprovar ou reverter a mudança sob o cursor"
      },
      {
        "command": "km.chancelarArquivo",
        "title": "km: chancelar o arquivo inteiro"
      }
    ],
    "configuration": {
      "title": "km",
      "properties": {
        "km.path": {
          "type": "string",
          "default": "",
          "description": "Caminho do executável km. Vazio = ~/knowledge-manager/bin/km"
        },
        "km.port": {
          "type": "number",
          "default": 8431,
          "description": "Porta do painel local (`km serve`). Ele sobe quando você abre o painel e morre com a janela."
        }
      }
    },
    "keybindings": [
      {
        "command": "km.veredicto",
        "key": "ctrl+alt+k",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "km.abrirPainel",
        "key": "ctrl+alt+p",
        "when": "editorLangId == markdown || activeCustomEditorId == 'markdown-editor.customEditor'"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "km.abrirPainel",
          "group": "km@0",
          "when": "editorLangId == markdown"
        },
        {
          "command": "km.veredicto",
          "group": "km@1",
          "when": "editorLangId == markdown"
        },
        {
          "command": "km.review",
          "group": "km@2",
          "when": "editorLangId == markdown"
        },
        {
          "command": "km.chancelarArquivo",
          "group": "km@3",
          "when": "editorLangId == markdown"
        }
      ]
    }
  }
}
